{
  "name": "daoforge",
  "version": "1.0.0",
  "description": "DAOForge -- Cross-Chain DAO Infrastructure Suite",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile 2>&1 | tee compile.log",
    "test": "hardhat test --network hardhat 2>&1 | tee test.log",
    "deploy": "hardhat deploy --network sepolia 2>&1 | tee deploy.log",
    "coverage": "hardhat coverage 2>&1 | tee coverage.log",
    "lint": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "hardhat": "^2.19.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat-gas-reporter": "^1.0.0",
    "solidity-coverage": "^0.8.0",
    "typechain": "^8.0.0",
    "@typechain/ethers-v6": "^0.4.0",
    "@typechain/hardhat": "^8.0.0",
    "solhint": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  }
}